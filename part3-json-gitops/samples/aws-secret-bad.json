{
  "apiVersion": "infra.acme.io/v1",
  "kind": "AwsSecretsManagerSecret",
  "metadata": {
    "name": "payments-stripe-key",
    "environment": "prod",
    "labels": {
      "team": "checkout"
    }
  },
  "spec": {
    "secretName": "prod/payments/stripe-api-key",
    "region": "eu-central-1",
    "description": "Quick manual override",
    "kmsKeyId": "alias/aws/secretsmanager",
    "rotationEnabled": true,
    "rotationDays": 30,
    "secretString": "sk_live_dont_put_this_in_git"
  }
}
