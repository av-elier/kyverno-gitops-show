{
  "apiVersion": "infra.acme.io/v1",
  "kind": "AwsSecretsManagerSecret",
  "metadata": {
    "name": "payments-stripe-key",
    "environment": "prod",
    "labels": {
      "team": "checkout",
      "compliance": "pci-dss"
    }
  },
  "spec": {
    "secretName": "prod/payments/stripe-api-key",
    "region": "eu-central-1",
    "description": "Stripe API key rotated every 60 days via Terraform",
    "kmsKeyId": "arn:aws:kms:eu-central-1:111122223333:key/8d3b4c5e-1111-2222-3333-444455556666",
    "rotationEnabled": true,
    "rotationDays": 60
  }
}
